{
  "name": "ai-native-qa-toolkit",
  "version": "1.0.0",
  "private": true,
  "description": "AI-native QA toolkit \u2014 engineering constitution, on-demand skills, product-side testability constitutions, and a lint gate that enforces the checkable half.",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "lint:gate": "npx eslint \"tests/**/*.ts\" \"pages/**/*.ts\" --max-warnings 0",
    "test:rules": "node eslint-plugin-qa-constitution/tests/rules.test.js",
    "test:faults": "node eslint-plugin-qa-constitution/tests/fault-injection.test.mjs",
    "eval:compare": "node scripts/eval-compare.mjs",
    "check:bump": "node scripts/check-version-bump.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
