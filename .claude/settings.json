{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/alternatives-gate.mjs", "ask"],
            "timeout": 15,
            "statusMessage": "Checking the alternatives were built"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/alternatives-gate.mjs", "stop"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
